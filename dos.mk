# DOS build through Open386MAX's shared OpenWatcom/JWasm build system.
OPEN386MAX ?= deps/Open386MAX
OPENASPI   ?= deps/OpenASPI
PROJ       := OpenTape
ROOT       := $(abspath $(OPEN386MAX))
SRCDIRS    := src core backends/legacy_tape tests
ASMINC     := include $(abspath $(OPENASPI))/include $(ROOT)/INCLUDE $(ROOT)/INC \
	$(ROOT)/QUILIB $(ROOT)/386MAX
CASEMAP    := mx
CMODEL     := l
CDEFS      := DOS_VERSION
PROGS      := OPENTAPE.EXE NATTEST.EXE PAYTEST.EXE VERTEST.EXE WRITEST.EXE OUTTEST.EXE TAPETEST.EXE SRCTEST.EXE FILEREAD.EXE TREEREAD.EXE PLANTEST.EXE STRMTEST.EXE RESTEST.EXE RSTCMP.EXE SELTEST.EXE

OPENTAPE.EXE_OBJS  := MAIN.OBJ BACKUP.OBJ RSTDOS.OBJ RESTORE.OBJ PLAN.OBJ SOURCE.OBJ BACKEND.OBJ VOLUME.OBJ PROBE.OBJ LEGACY.OBJ READER.OBJ NATIVE.OBJ PAYLOAD.OBJ VERIFY.OBJ STREAM.OBJ WRITER.OBJ OUTPUT.OBJ
OPENTAPE.EXE_LIBS  := $(ROOT)/build/QUILIB/LQUILIBR.LIB
OPENTAPE.EXE_STACK := 9000
MAIN.OBJ_SRC       := main.c
CATALOG.OBJ_SRC    := archive_catalog.c
OPENTAPE.EXE_OBJS += CATALOG.OBJ
BACKUP.OBJ_SRC     := backup_dos.c
RSTDOS.OBJ_SRC     := restore_dos.c
RESTORE.OBJ_SRC    := restore.c
SELECT.OBJ_SRC     := restore_select.c
SELTEST.OBJ_SRC    := test_restore_selection.c
SELTEST.EXE_OBJS   := SELTEST.OBJ SELECT.OBJ PAYLOAD.OBJ VOLUME.OBJ
SELTEST.EXE_STACK  := 9000
EXCHANGE.OBJ_SRC   := restore_exchange.c
RESTEST.OBJ_SRC    := test_restore.c
RESTEST.EXE_OBJS   := RESTEST.OBJ RESTORE.OBJ WRITER.OBJ VERIFY.OBJ PAYLOAD.OBJ NATIVE.OBJ VOLUME.OBJ
RESTEST.EXE_STACK  := 9000
RSTCMP.OBJ_SRC     := restore_compare.c
RSTCMP.EXE_OBJS    := RSTCMP.OBJ LEGACY.OBJ PLAN.OBJ SOURCE.OBJ PROBE.OBJ WRITER.OBJ VERIFY.OBJ PAYLOAD.OBJ NATIVE.OBJ VOLUME.OBJ
RSTCMP.EXE_STACK   := 9000
SOURCE.OBJ_SRC     := source_file.c
RBTEST.OBJ_SRC     := restore_readback.c
RBTEST.EXE_OBJS    := RBTEST.OBJ LEGACY.OBJ PLAN.OBJ SOURCE.OBJ PROBE.OBJ WRITER.OBJ VERIFY.OBJ PAYLOAD.OBJ NATIVE.OBJ VOLUME.OBJ SELECT.OBJ EXCHANGE.OBJ
RBTEST.EXE_STACK   := 9000
PROGS += RBTEST.EXE
PLAN.OBJ_SRC       := backup_plan.c
PLANTEST.OBJ_SRC   := test_backup_plan.c
PLANTEST.EXE_OBJS  := PLANTEST.OBJ PLAN.OBJ SOURCE.OBJ WRITER.OBJ VERIFY.OBJ PAYLOAD.OBJ NATIVE.OBJ VOLUME.OBJ
PLANTEST.EXE_STACK := 9000
SRCTEST.OBJ_SRC    := test_source_file.c
SRCTEST.EXE_OBJS   := SRCTEST.OBJ SOURCE.OBJ WRITER.OBJ VERIFY.OBJ PAYLOAD.OBJ NATIVE.OBJ VOLUME.OBJ
SRCTEST.EXE_STACK  := 9000
FILEREAD.OBJ_SRC   := file_readback.c
FILEREAD.EXE_OBJS  := FILEREAD.OBJ READER.OBJ PROBE.OBJ LEGACY.OBJ PLAN.OBJ SOURCE.OBJ WRITER.OBJ VERIFY.OBJ PAYLOAD.OBJ NATIVE.OBJ VOLUME.OBJ
FILEREAD.EXE_STACK := 9000
TREEREAD.OBJ_SRC   := tree_readback.c
TREEREAD.EXE_OBJS  := TREEREAD.OBJ READER.OBJ PROBE.OBJ LEGACY.OBJ PLAN.OBJ SOURCE.OBJ WRITER.OBJ VERIFY.OBJ PAYLOAD.OBJ NATIVE.OBJ VOLUME.OBJ
TREEREAD.EXE_STACK := 9000
BACKEND.OBJ_SRC    := backend.c
VOLUME.OBJ_SRC     := volume_format.c
PROBE.OBJ_SRC      := tape_probe.c
PRBTEST.OBJ_SRC    := test_tape_probe.c
PRBTEST.EXE_OBJS   := PRBTEST.OBJ PROBE.OBJ
PRBTEST.EXE_STACK  := 9000
PROGS += PRBTEST.EXE
LEGACY.OBJ_SRC     := legacy_dos.c
READER.OBJ_SRC     := tape_reader.c
OUTPUT.OBJ_SRC     := tape_output.c
OUTTEST.OBJ_SRC    := test_tape_output.c
OUTTEST.EXE_OBJS   := OUTTEST.OBJ OUTPUT.OBJ PROBE.OBJ
OUTTEST.EXE_STACK  := 9000
TAPETEST.OBJ_SRC   := tape_native.c
TAPETEST.EXE_OBJS  := TAPETEST.OBJ OUTPUT.OBJ READER.OBJ PROBE.OBJ LEGACY.OBJ PLAN.OBJ SOURCE.OBJ WRITER.OBJ VERIFY.OBJ PAYLOAD.OBJ NATIVE.OBJ VOLUME.OBJ
TAPETEST.EXE_STACK := 9000
NATIVE.OBJ_SRC     := native_scan.c
NATTEST.OBJ_SRC    := test_native_scan.c
NATTEST.EXE_OBJS  := NATTEST.OBJ NATIVE.OBJ VOLUME.OBJ PAYLOAD.OBJ
NATTEST.EXE_STACK := 9000
PAYLOAD.OBJ_SRC   := record_payload.c
PAYTEST.OBJ_SRC   := test_record_payload.c
PAYTEST.EXE_OBJS  := PAYTEST.OBJ PAYLOAD.OBJ NATIVE.OBJ VOLUME.OBJ
PAYTEST.EXE_STACK := 9000
VERIFY.OBJ_SRC    := archive_verify.c
STREAM.OBJ_SRC    := verify_stream.c
STRMTEST.OBJ_SRC  := test_verify_stream.c
STRMTEST.EXE_OBJS := STRMTEST.OBJ STREAM.OBJ READER.OBJ PROBE.OBJ WRITER.OBJ VERIFY.OBJ PAYLOAD.OBJ NATIVE.OBJ VOLUME.OBJ
STRMTEST.EXE_OBJS += CATALOG.OBJ SELECT.OBJ
STRMTEST.EXE_STACK := 9000
VERTEST.OBJ_SRC   := test_archive_verify.c
VERTEST.EXE_OBJS  := VERTEST.OBJ VERIFY.OBJ PAYLOAD.OBJ NATIVE.OBJ VOLUME.OBJ
VERTEST.EXE_STACK := 9000
WRITER.OBJ_SRC    := archive_writer.c
WRITEST.OBJ_SRC   := test_archive_writer.c
WRITEST.EXE_OBJS  := WRITEST.OBJ WRITER.OBJ VERIFY.OBJ PAYLOAD.OBJ NATIVE.OBJ VOLUME.OBJ
WRITEST.EXE_STACK := 9000

$(ROOT)/linux/bin/jwasm $(ROOT)/linux/bin/jwlink:
	$(MAKE) -C $(ROOT) -f GNUmakefile tools

$(ROOT)/build/QUILIB/LQUILIBR.LIB:
	$(MAKE) -C $(ROOT) -f GNUmakefile \
		OUT=$(ROOT)/build/QUILIB BINDIR=$(ROOT)/build/bin QUILIB

OPENTAPE.EXE_OBJS += SELECT.OBJ EXCHANGE.OBJ
RESTEST.EXE_OBJS += SELECT.OBJ EXCHANGE.OBJ
RSTCMP.EXE_OBJS += SELECT.OBJ EXCHANGE.OBJ
FILEREAD.EXE_OBJS += SELECT.OBJ EXCHANGE.OBJ
TREEREAD.EXE_OBJS += SELECT.OBJ EXCHANGE.OBJ
TAPETEST.EXE_OBJS += SELECT.OBJ EXCHANGE.OBJ

ifneq ($(wildcard $(OPENASPI)/include/openaspi/tape_api.h),)
CDEFS += OT_NATIVE_TAPE_API
SRCDIRS += $(abspath $(OPENASPI))/common/tape backends/openaspi
ANATIVE.OBJ_SRC := archive_native.c
ADOS.OBJ_SRC := archive_dos.c
NTAPI.OBJ_SRC := tape_native_api.c
TAPI.OBJ_SRC := tape_api.c
NTCLI.OBJ_SRC := native_dos_cli.c
OPENTAPE.EXE_OBJS += NTCLI.OBJ
$(foreach p,$(PROGS),$(if $(filter LEGACY.OBJ,$($(p)_OBJS)),$(eval $(p)_OBJS += NTAPI.OBJ TAPI.OBJ ANATIVE.OBJ ADOS.OBJ $(filter-out $($(p)_OBJS),READER.OBJ OUTPUT.OBJ STREAM.OBJ))))
NAPIUT.OBJ_SRC := test_native_api.c
NAPIUT.EXE_OBJS := NAPIUT.OBJ NTAPI.OBJ TAPI.OBJ
NAPIUT.EXE_STACK := 9000
NTREAD.OBJ_SRC := native_record_dos.c
NTREAD.EXE_OBJS := NTREAD.OBJ $(filter-out TAPETEST.OBJ,$(TAPETEST.EXE_OBJS))
NTREAD.EXE_STACK := 9000
NTWRITE.OBJ_SRC := native_write_dos.c
NTWRITE.EXE_OBJS := NTWRITE.OBJ $(filter-out NTREAD.OBJ,$(NTREAD.EXE_OBJS))
NTWRITE.EXE_STACK := 9000
NTFIX.OBJ_SRC := native_fixed_dos.c
NTFIX.EXE_OBJS := NTFIX.OBJ $(filter-out NTREAD.OBJ,$(NTREAD.EXE_OBJS))
NTFIX.EXE_STACK := 9000
NTSPACE.OBJ_SRC := native_space_dos.c
NTSPACE.EXE_OBJS := NTSPACE.OBJ $(filter-out NTREAD.OBJ,$(NTREAD.EXE_OBJS))
NTSPACE.EXE_STACK := 9000
NTMEDIA.OBJ_SRC := native_media_dos.c
NTMEDIA.EXE_OBJS := NTMEDIA.OBJ $(filter-out NTREAD.OBJ,$(NTREAD.EXE_OBJS))
NTMEDIA.EXE_STACK := 9000
PROGS += NAPIUT.EXE NTREAD.EXE NTWRITE.EXE NTFIX.EXE NTSPACE.EXE NTMEDIA.EXE
endif

include $(ROOT)/linux/mk/dos.mk

# The shared legacy rules track flat uppercase .H files, not our nested
# lowercase headers. Track them locally so header-only edits cannot leave
# stale language strings, layouts or ABI declarations in DOS objects.
OPENTAPE_HEADERS := $(wildcard include/opentape/*.h) $(wildcard $(OPENASPI)/include/openaspi/*.h) core/wire.h
$(addprefix $(OUT)/,$(COBJS)): $(OPENTAPE_HEADERS)
$(CINCDIR)/.done: $(OPENTAPE_HEADERS)
