# DOS build through Open386MAX's shared OpenWatcom/JWasm build system.
OPEN386MAX ?= deps/Open386MAX
OPENASPI   ?= deps/OpenASPI
PROJ       := OpenTape
ROOT       := $(abspath $(OPEN386MAX))
SRCDIRS    := src core backends/legacy_tape tests
ASMINC     := include $(abspath $(OPENASPI))/include $(ROOT)/INCLUDE $(ROOT)/INC \
	$(ROOT)/QUILIB $(ROOT)/386MAX
CASEMAP    := mx
CMODEL     := l
CDEFS      := DOS_VERSION
PROGS      := OPENTAPE.EXE NATTEST.EXE PAYTEST.EXE VERTEST.EXE WRITEST.EXE OUTTEST.EXE TAPETEST.EXE SRCTEST.EXE FILEREAD.EXE TREEREAD.EXE PLANTEST.EXE STRMTEST.EXE RESTEST.EXE RSTCMP.EXE SELTEST.EXE

OPENTAPE.EXE_OBJS  := MAIN.OBJ BACKUP.OBJ RSTDOS.OBJ RESTORE.OBJ PLAN.OBJ SOURCE.OBJ BACKEND.OBJ VOLUME.OBJ PROBE.OBJ LEGACY.OBJ READER.OBJ NATIVE.OBJ PAYLOAD.OBJ VERIFY.OBJ STREAM.OBJ WRITER.OBJ OUTPUT.OBJ
OPENTAPE.EXE_LIBS  := $(ROOT)/build/QUILIB/LQUILIBR.LIB
# QUILIB's editor also exports QuickWin. Select the common owner explicitly
# so another UI module cannot accidentally pull the editor/help subsystem.
OPENTAPE.EXE_LINKOPTS += file $(ROOT)/build/QUILIB/OWNER.OBJ
$(ROOT)/build/QUILIB/OWNER.OBJ: | $(ROOT)/build/QUILIB/LQUILIBR.LIB
	$(MAKE) -C $(ROOT) -f GNUmakefile OUT=$(ROOT)/build/QUILIB BINDIR=$(ROOT)/build/bin QUILIB
# Shared dialogs plus the 16-level source planner and DOS canonicalizer.
OPENTAPE.EXE_STACK := 16000
